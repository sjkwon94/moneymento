<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#FFFDFAF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="통합 자산관리"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#3D3A35" />
        <TextView
            android:id="@+id/tv_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#C17A55" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="₩0"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#3D3A35"
        android:layout_marginTop="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">
        <ProgressBar
            android:id="@+id/progress_goal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:progress="0"
            android:max="10000"
            android:progressTint="#C17A55"
            android:progressBackgroundTint="#EBE4D8" />
        <TextView
            android:id="@+id/tv_progress_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00%"
            android:textSize="10sp"
            android:textColor="#8F8778"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="목표 ₩0"
        android:textSize="10sp"
        android:textColor="#8F8778"
        android:layout_marginTop="3dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="자산 구성"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#8F8778"
        android:layout_marginTop="12dp" />
    <ImageView
        android:id="@+id/img_asset_donut"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginTop="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="이번 달 지출"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#8F8778"
        android:layout_marginTop="10dp" />
    <ImageView
        android:id="@+id/img_expense_donut"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tv_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="갱신 중..."
            android:textSize="9sp"
            android:textColor="#C0B9AE"
            android:gravity="end" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻ 새로고침"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#C17A55"
            android:background="#F5EDE4"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
